    {
        "id": "9939736c0d9212ad",
        "type": "ui_template",
        "z": "1819c250933b64f5",
        "group": "327e4a4f240f2bd2",
        "name": "Custom CSS",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap');\n\n/* ═══ GLOBAL RESET ═══ */\n*, *::before, *::after { box-sizing: border-box; }\n\nbody, .nr-dashboard-theme {\n    font-family: 'Rajdhani', 'Segoe UI', sans-serif !important;\n    background-color: #020617 !important;\n    background-image:\n        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(0,180,216,0.12) 0%, transparent 60%),\n        radial-gradient(ellipse 40% 40% at 80% 80%, rgba(0,229,176,0.06) 0%, transparent 50%),\n        linear-gradient(180deg, #020617 0%, #040c1f 100%) !important;\n}\n\n/* ═══ TOP BAR ═══ */\nmd-toolbar, .md-toolbar-tools {\n    background: linear-gradient(90deg, #020617 0%, #051030 60%, #020617 100%) !important;\n    border-bottom: 1px solid rgba(0,180,216,0.3) !important;\n    box-shadow: 0 0 30px rgba(0,180,216,0.1) !important;\n}\nmd-toolbar h1, .md-toolbar-tools span {\n    font-family: 'Rajdhani', sans-serif !important;\n    font-weight: 700 !important;\n    font-size: 17px !important;\n    letter-spacing: 3px !important;\n    text-transform: uppercase !important;\n    color: #e0f7ff !important;\n    text-shadow: 0 0 20px rgba(0,180,216,0.6) !important;\n}\n\n/* ═══ CARDS ═══ */\nmd-card {\n    background: linear-gradient(135deg, #060d1f 0%, #0a1528 100%) !important;\n    border-radius: 12px !important;\n    border: 1px solid rgba(0,180,216,0.18) !important;\n    box-shadow:\n        0 0 0 1px rgba(0,180,216,0.05),\n        0 8px 32px rgba(0,0,0,0.6),\n        inset 0 1px 0 rgba(255,255,255,0.04) !important;\n    margin: 8px !important;\n    overflow: hidden;\n    transition: border-color 0.3s ease, box-shadow 0.3s ease;\n    position: relative;\n}\nmd-card::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(0,180,216,0.5), transparent);\n}\nmd-card:hover {\n    border-color: rgba(0,180,216,0.35) !important;\n    box-shadow:\n        0 0 0 1px rgba(0,180,216,0.1),\n        0 12px 40px rgba(0,0,0,0.7),\n        0 0 20px rgba(0,180,216,0.06) !important;\n}\n\n/* ═══ GROUP HEADERS ═══ */\n.nr-dashboard-cardtitle {\n    color: #7ec8e3 !important;\n    font-family: 'Rajdhani', sans-serif !important;\n    font-size: 11px !important;\n    font-weight: 600 !important;\n    letter-spacing: 3px !important;\n    text-transform: uppercase !important;\n    border-bottom: 1px solid rgba(0,180,216,0.15) !important;\n    padding: 10px 16px 10px !important;\n    margin-bottom: 8px !important;\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px;\n}\n.nr-dashboard-cardtitle::before {\n    content: '';\n    display: inline-block;\n    width: 6px; height: 6px;\n    border-radius: 50%;\n    background: #00b4d8;\n    box-shadow: 0 0 8px #00b4d8;\n    flex-shrink: 0;\n}\n\n/* ═══ GAUGE ═══ */\nnr-gauge, .nr-dashboard-gauge {\n    padding: 8px 0 !important;\n}\n.gauge-value, text.gauge-value {\n    font-family: 'Share Tech Mono', monospace !important;\n    fill: #e0f7ff !important;\n}\ntext { fill: #7ec8e3 !important; font-family: 'Rajdhani', sans-serif !important; }\n\n/* ═══ CHART ═══ */\n.nvd3 text { fill: #4a7fa0 !important; font-family: 'Rajdhani', sans-serif !important; font-size: 11px !important; }\n.nvd3 .nv-axis line, .nvd3 .nv-axis path { stroke: rgba(0,180,216,0.12) !important; }\n.nvd3 .nv-axis .zero line { stroke: rgba(0,180,216,0.2) !important; }\n.nvd3 .nv-legend text { fill: #7ec8e3 !important; font-size: 12px !important; }\n.nvd3 .nv-background rect { fill: transparent !important; }\n\n/* ═══ SWITCH ═══ */\nmd-switch .md-thumb {\n    background-color: #1e3a5f !important;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.4) !important;\n}\nmd-switch.md-checked .md-thumb {\n    background-color: #00b4d8 !important;\n    box-shadow: 0 0 12px rgba(0,180,216,0.5) !important;\n}\nmd-switch .md-bar {\n    background-color: #0e2040 !important;\n    border-radius: 8px !important;\n}\nmd-switch.md-checked .md-bar {\n    background-color: rgba(0,180,216,0.25) !important;\n    border: 1px solid rgba(0,180,216,0.4) !important;\n}\n.nr-dashboard-switch label {\n    color: #cdd6f4 !important;\n    font-family: 'Rajdhani', sans-serif !important;\n    font-size: 15px !important;\n    font-weight: 500 !important;\n    letter-spacing: 0.5px !important;\n}\n\n/* ═══ LOG / TEXT WIDGET ═══ */\n.nr-dashboard-text {\n    font-family: 'Share Tech Mono', monospace !important;\n    font-size: 13px !important;\n    color: #00e5b0 !important;\n    text-shadow: 0 0 10px rgba(0,229,176,0.4) !important;\n    letter-spacing: 0.5px !important;\n    padding: 4px 8px;\n    background: rgba(0,229,176,0.05);\n    border-left: 2px solid rgba(0,229,176,0.4);\n    border-radius: 0 4px 4px 0;\n}\n.nr-dashboard-text-label {\n    color: #4a7fa0 !important;\n    font-family: 'Rajdhani', sans-serif !important;\n    font-size: 12px !important;\n    font-weight: 600 !important;\n    letter-spacing: 1px !important;\n    text-transform: uppercase !important;\n}\n\n/* ═══ SCROLLBAR ═══ */\n::-webkit-scrollbar { width: 4px; background: #020617; }\n::-webkit-scrollbar-thumb { background: rgba(0,180,216,0.3); border-radius: 2px; }\n</style>",
